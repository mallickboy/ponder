[Unit]
Description=Gunicorn instance for PySearch
After=network.target

[Service]
User=mallickboy
Group=www-data
WorkingDirectory=/home/mallickboy/ponder/backend
ExecStart=/home/mallickboy/ponder/backend/.venv/bin/gunicorn app.server:app \
  --worker-class uvicorn.workers.UvicornWorker \
  --bind 0.0.0.0:8080 \
  --workers 2 \
  --timeout 120

StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=gunicorn

[Install]
WantedBy=multi-user.target
